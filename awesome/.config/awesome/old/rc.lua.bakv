globalkeys = gears.table.join(globalkeys,
    -- // MARK: LAYOUT KEYS
    -- layout control hotkeys

    -- master client count management - adjusts how many windows get primary positioning
    awful.key({ modkey, shiftkey }, "h", function() 
        awful.tag.incnmaster(1, nil, true)
        end, { description = "increase the number of master clients", group = "layout" }),

    awful.key({ modkey, shiftkey }, "l", function() 
        awful.tag.incnmaster(-1, nil, true)
        end, { description = "decrease the number of master clients", group = "layout" }),

    -- treetile layout controls - switches between vertical and horizontal tree arrangements
    awful.key({ modkey, altkey }, "v", treetile.vertical,
        { description = "switch to vertical treetile layout", group = "layout" }),

    awful.key({ modkey, altkey }, "h", treetile.horizontal,
        { description = "switch to horizontal treetile layout", group = "layout" })

    -- layout cycling with Mod+Shift+r moved to 'Awesome control and layout keybindings' below
    -- to avoid duplicates and keep Mod+r / Mod+Shift+r centralized.
)


