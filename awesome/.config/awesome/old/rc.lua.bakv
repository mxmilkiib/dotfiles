-- // MARK: BUTTONS


-- mouse button bindings for taglist and tasklist (defined early to avoid nil during widget creation)
local taglist_buttons = gears.table.join(
    awful.button({}, 1, function(t) t:view_only() end),
    awful.button({modkey}, 1, function(t) if client.focus then client.focus:move_to_tag(t) end end),
    awful.button({}, 3, awful.tag.viewtoggle),
    awful.button({modkey}, 3, function(t) if client.focus then client.focus:toggle_tag(t) end end),
    awful.button({}, 4, function(t) awful.tag.viewnext(t.screen) end),
    awful.button({}, 5, function(t) awful.tag.viewprev(t.screen) end))

local tasklist_buttons = gears.table.join(
    awful.button({}, 1, function(c)
        if c == client.focus then
            c.minimized = true
        else
            c:emit_signal("request::activate", "tasklist", {raise = true})
        end
    end),
    awful.button({}, 3, function() awful.menu.client_list({theme = {width = 250}}) end),
    awful.button({}, 4, function() awful.client.focus.byidx(1) end),
    awful.button({}, 5, function() awful.client.focus.byidx(-1) end))

-- Create mylauncher early so setup_screen_ui can use it
local mylauncher = awful.widget.launcher({
    image = beautiful.awesome_icon,
    menu = mymainmenu
})

-- Create client state indicator squares for tags globally so widget templates can use them
-- Using custom creation to ensure proper rendering with specific colors
local cairo = require("lgi").cairo
local tag_square_size = 8 -- Larger 8px square for better visibility

-- Custom function for creating indicator squares with specific appearance
local function create_indicator_square(filled)
    local size = tag_square_size
    local img = cairo.ImageSurface(cairo.Format.ARGB32, size, size)
    local cr = cairo.Context(img)

    if filled then
        -- Filled square for unminimized windows
        cr:set_source_rgba(0.8, 0.8, 0.8, 1) -- Light gray
        cr:rectangle(0, 0, size, size)
        cr:fill()
    else
        -- Hollow square for minimized-only windows
        cr:set_source_rgba(0.7, 0.7, 0.7, 1) -- Gray
        cr:set_line_width(1.0)
        cr:rectangle(0.5, 0.5, size - 1, size - 1)
        cr:stroke()
    end

    return img
end

-- Create our indicator squares with proper size
local filled_square = create_indicator_square(true)
local hollow_square = create_indicator_square(false)

-- Build all UI widgets for a specific screen
-- NOTE: This wibar implementation uses direct wibox constructor instead of awful.wibar
-- due to rendering issues with the latter. The wibox approach provides better
-- compatibility and more reliable rendering across different environments.
--
-- Key points:
-- 1. Using wibox constructor with explicit positioning and dimensions
-- 2. Setting type="dock" for proper window manager integration
-- 3. Ensuring opacity=1.0 and ontop=true for visibility
-- 4. Properly using struts to reserve space for the wibar
function setup_screen_ui(s)
    
    -- Create a promptbox for each screen
    s.mypromptbox = awful.widget.prompt()
    
    -- Create a layoutbox widget which will contain an icon indicating which layout we're using.
    -- We need one layoutbox per screen, using the older constructor syntax.
    s.mylayoutbox = awful.widget.layoutbox(s)
    
    -- Create a purple background container for the layout box
    s.mylayoutbox_container = wibox.container.background(s.mylayoutbox, beautiful.main_purple or "#623997")
    
    -- Debug function to manually cycle layouts with full info
    local function debug_cycle_layouts(increment)
        local s = mouse.screen or awful.screen.focused()
        local old_layout = awful.layout.get(s)
        local old_index = 0
        
        -- Find current layout index
        for i, layout in ipairs(awful.layout.layouts) do
            if layout == old_layout then
                old_index = i
                break
            end
        end
        
        -- Calculate next layout index with manual wrapping
        local new_index = old_index + increment
        if new_index > #awful.layout.layouts then new_index = 1 end
        if new_index < 1 then new_index = #awful.layout.layouts end
        
        -- Set the layout manually
        local new_layout = awful.layout.layouts[new_index]
        awful.layout.set(new_layout, s.selected_tag or s.tags[1])
        
        -- Show detailed debugging info
        naughty.notify({
            title = "Layout Change Debug",
            text = string.format("From: %s (#%d)\nTo: %s (#%d)\nDirection: %s\nTotal layouts: %d", 
                          awful.layout.getname(old_layout) or "unknown", old_index,
                          awful.layout.getname(new_layout) or "unknown", new_index,
                          increment > 0 and "forward" or "backward",
                          #awful.layout.layouts),
            timeout = 3
        })
    end
    
    -- Set buttons for the layoutbox with the debug function
    s.mylayoutbox:buttons(gears.table.join(
        awful.button({ }, 1, function () debug_cycle_layouts(1) end),
        awful.button({ }, 2, function () 
            -- Apply the layout using milkdefault
            awful.layout.set(milkdefault, s.selected_tag or s.tags[1])
            
            -- Show notification
            naughty.notify({
                title = "Default Layout",
                text = "Switched to default layout: " .. (awful.layout.getname() or "centerwork_twothirds"),
                timeout = 1
            })
        end),
        awful.button({ }, 3, function () debug_cycle_layouts(-1) end),
        awful.button({ }, 4, function () debug_cycle_layouts(-1) end),
        awful.button({ }, 5, function () debug_cycle_layouts(1) end)
    ))
    
    -- Create the taglist with square-shaped tags only if it doesn't already exist
    if not s.mytaglist then
        s.mytaglist = awful.widget.taglist {
            screen = s,
            filter = awful.widget.taglist.filter.all,
            buttons = taglist_buttons,
            -- Make tags square with consistent shape
            style = {
                shape = gears.shape.square
        },
        layout = {
            spacing = 0, -- Remove spacing between tags
            layout = wibox.layout.fixed.horizontal
        },
        widget_template = {
            {
                {
                    {
                        id = "text_role",
                        widget = wibox.widget.textbox,
                        align = "center",
                        valign = "center",
                        forced_width = 24, -- Match the tag width
                    },
                    layout = wibox.layout.fixed.horizontal,
                },
                {
                    {
                        -- Add client state indicator with padding to make it more visible
                        id = "indicator_role", 
                        widget = wibox.widget.imagebox,
                        resize = false,  -- Don't resize the image
                        forced_width = 8,
                        forced_height = 8,
                    },
                    top = 0,    -- Position indicator flush with top
                    left = 0,   -- Position indicator flush with left edge
                    widget = wibox.container.margin,
                },
                layout = wibox.layout.stack,  -- Stack layout places indicator over the text
                fill_space = true,
                top = 2,
                bottom = 2,
                widget = wibox.container.margin
            },
            id = "background_role",
            widget = wibox.container.background,
            forced_width = 24, -- Make the tag exactly square (same as wibar height)
            forced_height = 24,
            create_callback = function(self, tag, index, tags)
                -- Update the indicator whenever we create the widget
                local indicator = self:get_children_by_id("indicator_role")[1]
                local text_widget = self:get_children_by_id("text_role")[1]
                
                -- Apply shimmer effect to ALL tags during creation
                if text_widget and apply_shimmer_to_widget then
                    -- Always apply shimmer regardless of tag selection state
                    apply_shimmer_to_widget(text_widget, tag.name or "", nil)
                end
                
                if indicator then
                    -- Check tag state
                    local clients = tag:clients()
                    local has_clients = #clients > 0
                    local has_visible = false
                    
                    for _, c in ipairs(clients) do
                        if not c.minimized then
                            has_visible = true
                            break
                        end
                    end
                    
                    if has_clients then
                        if has_visible then
                            -- Tag has visible clients - filled square
                            indicator.image = filled_square
                        else
                            -- Tag has only minimized clients - hollow square
                            indicator.image = hollow_square
                        end
                    else
                        -- No clients, no indicator
                        indicator.image = nil
                    end
                end
            end,
            update_callback = function(self, tag, index, tags)
                -- Update the indicator whenever the widget is updated
                local indicator = self:get_children_by_id("indicator_role")[1]
                local text_widget = self:get_children_by_id("text_role")[1]
                
                -- Always set a compatible, visible background that works with shimmer
                if tag.selected then
                    -- Use solid black background for selected tags for maximum shimmer visibility
                    self.bg = "#000000"
                else
                    -- Use dark background for non-selected tags
                    self.bg = "#222222"
                end
                
                -- Clear any foreground color to let shimmer control it completely
                self.fg = nil
                
                -- Always force shimmer application for maximum visibility
                if text_widget then
                    -- Override any existing styling on the text widget itself
                    if text_widget.set_bg then
                        text_widget:set_bg("transparent")
                    end
                    
                    -- Apply shimmer with extreme visibility
                    apply_shimmer_to_widget(text_widget, tag.name or "", nil)
                    
                    -- Set an update timestamp to track that we've processed this update
                    text_widget.__last_shimmer_update = os.time()
                end
                
                if indicator then
                    -- Check tag state
                    local clients = tag:clients()
                    local has_clients = #clients > 0
                    local has_visible = false
                    
                    for _, c in ipairs(clients) do
                        if not c.minimized then
                            has_visible = true
                            break
                        end
                    end
                    
                    if has_clients then
                        if has_visible then
                            -- Tag has visible clients - filled square
                            indicator.image = filled_square
                        else
                            -- Tag has only minimized clients - hollow square
                            indicator.image = hollow_square
                        end
                    else
                        -- No clients, no indicator
                        indicator.image = nil
                    end
                end
            end
        }
    }
    
    -- Create a tasklist with 16px icons, reduced padding and proper vertical alignment
    s.mytasklist = awful.widget.tasklist {
        screen = s,
        filter = awful.widget.tasklist.filter.currenttags,
        buttons = tasklist_buttons,
        style = {
            shape = gears.shape.rectangle
        },
        layout = {
            spacing = 2,
            layout = wibox.layout.flex.horizontal
        },
        widget_template = {
            {
                {
                    {
                        {
                            id = 'icon_role',
                            widget = wibox.widget.imagebox,
                            resize = true,
                            forced_width = 16,
                            forced_height = 16,
                        },
                        top = 4,    -- Center vertically in 24px height
                        bottom = 4, -- Center vertically in 24px height
                        right = 4,  -- Space between icon and text
                        left = 0,   -- No left padding for icon
                        widget = wibox.container.margin,
                    },
                    {
                        id = 'text_role',
                        widget = wibox.widget.textbox,
                        valign = "center", -- Vertically center text
                    },
                    layout = wibox.layout.fixed.horizontal,
                    fill_space = true, -- Make sure elements use available space
                },
                left = 6,  -- Reduced left padding
                right = 10,
                widget = wibox.container.margin
            },
            id = 'background_role',
            widget = wibox.container.background,
            create_callback = function(self, c, index, objects)
                -- Apply shimmer effect to focused client task title
                local text_widget = self:get_children_by_id('text_role')[1]
                if c.active and text_widget and apply_shimmer_to_widget then
                    -- Use light gray for non-shimmer text to ensure shimmer is visible
                    self.fg = "#AAAAAA"
                    -- Apply shimmer to focused client title
                    apply_shimmer_to_widget(text_widget, c.name or c.class or "", nil)
                end
            end,
            update_callback = function(self, c, index, objects)
                -- Update the task whenever the widget is updated
                local text_widget = self:get_children_by_id('text_role')[1]
                if text_widget then
                    -- Get client status prefix with any needed icons
                    local status_prefix = get_client_status_prefix(c)
                    
                    -- Use black background for maximum shimmer visibility
                    if client.focus and client.focus == c then
                        -- Black background for focused client gives best contrast with shimmer
                        self.bg = "#000000"
                    else
                        -- Dark background for unfocused clients
                        self.bg = "#222222"
                    end
                    
                    -- Clear any foreground color to let shimmer control it completely
                    self.fg = nil
                    
                    -- Override any existing styling on the text widget itself
                    if text_widget.set_bg then
                        text_widget:set_bg("transparent")
                    end
                    
                    -- Always apply shimmer with extreme visibility regardless of focus state
                    apply_shimmer_to_widget(text_widget, c.name or c.class or "", status_prefix)
                    
                    -- Set an update timestamp to track shimmer
                    text_widget.__last_shimmer_update = os.time()
                end
            end
        },
    }
    
    -- Create a textclock with formatting
    local mytextclock = wibox.widget.textclock()
    
    -- Style the textclock with theme colors and add internal padding
    local mytextclock_with_margin = wibox.container.margin(mytextclock, 3, 3, 2, 2) -- Add padding inside the clock
    local clock_with_bg = wibox.container.background(mytextclock_with_margin)
    clock_with_bg.bg = beautiful.main_purple or beautiful.bg_focus or "#663399"
    clock_with_bg.fg = "#FFFFFF"
    
    -- Create a systray with proper spacing
    local systray = wibox.widget.systray()
    local systray_container = wibox.container.margin(systray, 6, 6, 2, 2)
    
    -- Create the wibar using direct wibox constructor (proven to work from testing)
    -- Check if wibox already exists to avoid duplicates
    if not s.mywibox then
        s.mywibox = wibox({
            x = 0,
            y = 0,
            width = s.geometry.width,
            height = 24,  -- Updated height to 24px as requested
            screen = s,
            bg = beautiful.bg_normal or "#222222",
            fg = beautiful.fg_normal or "#FFFFFF", 
            opacity = 1.0,  -- Full opacity
            visible = true, 
            ontop = true,   
            type = "dock"  -- Use dock type for proper positioning
        })
    end
    
    -- Setup the widgets for our wibar with adjusted layout and spacing
    s.mywibox:setup {
        layout = wibox.layout.align.horizontal,
        { -- Left widgets
            layout = wibox.layout.fixed.horizontal,
            mylauncher, -- Logo with no margin
            s.mytaglist, -- Tags with no margin
            {
                s.mylayoutbox_container, -- Purple layout widget with margin
                widget = wibox.container.margin
            },
            s.mypromptbox,
        },
        s.mytasklist, -- Middle widget
        { -- Right widgets
            layout = wibox.layout.fixed.horizontal,
            wibox.container.margin(clock_with_bg, 1, 0, 0, 0), -- Time widget before systray with increased spacing
            wibox.container.margin(systray_container, 4, 4, 0, 0),
        }
    }
    
    -- Store the standard wibar configuration for reuse
    s.standard_wibar_setup = {
        layout = wibox.layout.align.horizontal,
        { -- Left widgets
            layout = wibox.layout.fixed.horizontal,
            mylauncher, 
            s.mytaglist,
            {
                s.mylayoutbox_container,
                left   = 4,
                right  = 4,
                top    = 4,
                bottom = 4,
                widget = wibox.container.margin
            },
            s.mypromptbox,
            -- More visible separator between layout and tasks
            {
                {
                widget = wibox.widget.separator,
                orientation = "vertical",
                forced_width = 2,
                    color = "#666666"
                },
                left = 4,
                right = 4,
                widget = wibox.container.margin
            },
        },
        s.mytasklist,
        { -- Right widgets
            layout = wibox.layout.fixed.horizontal,
            wibox.container.margin(clock_with_bg, 1, 0, 0, 0),
            wibox.container.margin(systray_container, 4, 4, 0, 0),
        }
    }
    
    -- Reserve space at the top
    s.mywibox:struts({ top = 24 })
end

-- Fallback function for wibar creation when needed
function ensure_wibar_for_screen(s)
    if s and s.mywibox then
        return s.mywibox
    end
    
    -- No wibar exists, create one with the same approach as our main wibar
    
    -- Create a minimal text-only clock
    local simple_clock = wibox.widget.textclock("%H:%M")
    
    -- Create the wibar using direct wibox constructor
    -- Don't recreate if already exists
    if not s.mywibox then
        s.mywibox = wibox({
            x = 0,
            y = 0,
            width = s.geometry.width,
            height = 28,  -- Different height in VerticalWibar mode
            screen = s,
            bg = beautiful.bg_normal,
            fg = beautiful.fg_normal,
            opacity = 1.0,
            visible = true,
            ontop = true,
            type = "dock"
        })
    end
    
    -- Setup with minimal widgets
    s.mywibox:setup {
        layout = wibox.layout.align.horizontal,
        nil,
        nil,
        simple_clock
    }
    
    -- Reserve space at the top
    s.mywibox:struts({ top = 24 })
    
    return s.mywibox
end

-- apply wallpaper and create widgets for each screen
awful.screen.connect_for_each_screen(function(s)
    -- wallpaper
    set_wallpaper(s)

    -- each screen has its own tag table
    -- Select the first layout in the list instead of the last
    local initial_layout = (awful.layout.layouts and awful.layout.layouts[1]) or awful.layout.suit.tile
    awful.tag({"1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "-", "="}, s, initial_layout)

    -- Quake terminal
    -- Create a dropdown terminal that appears from the top of the screen
    s.quake = lain.util.quake(
        {app = terminal},
        {settings = function(c) c.followtag = true
        end})

    -- Build per-screen UI (taglist/tasklist/wibar)
    -- Call setup_screen_ui directly instead of delayed
    setup_screen_ui(s)
end)

    -- Hide all notifications at startup
    gears.timer.delayed_call(function()
        naughty.destroy_all_notifications()
        
        -- Start shimmer animation immediately
        start_shimmer_animation()
    end)
    
    -- Also start shimmer animation directly to ensure it's running
    start_shimmer_animation()

-- Add signal handlers to ensure shimmer stays running
tag.connect_signal("property::selected", function(t)
    start_shimmer_animation()
end)

client.connect_signal("focus", function(c)
    start_shimmer_animation()
end)

-- Ensure shimmer plugin is properly loaded and started
do
    if not shimmer then
        local ok, mod = pcall(require, "plugins.shimmer")
        if ok then 
            shimmer = mod
            if shimmer.start then shimmer.start() end
            if shimmer.set_mode then shimmer.set_mode("border_sync") end
        else
            -- Failed to load shimmer plugin silently
        end
    else
        if shimmer.start then shimmer.start() end
    end
end

-- Connect to tag selection changes to apply shimmer effect with maximum visibility
tag.connect_signal("property::selected", function(t)
    -- Force immediate shimmer effect on tag change
    if t.screen then
        -- First ensure the shimmer animation is running at full speed
        start_shimmer_animation()
        
        -- Force immediate shimmer update on all widgets
        if force_shimmer_update then
            force_shimmer_update()
        end
        
        -- Force complete wibox redraw for maximum visibility
        if t.screen.mywibox then
            t.screen.mywibox:emit_signal("widget::redraw_needed")
        end
        
        -- Force taglist and tasklist redraw with multiple signals to ensure visibility
        if t.screen.mytaglist then
            t.screen.mytaglist:emit_signal("widget::redraw_needed")
            t.screen.mytaglist:emit_signal("widget::layout_changed")
        end
        
        if t.screen.mytasklist then
            t.screen.mytasklist:emit_signal("widget::redraw_needed")
            t.screen.mytasklist:emit_signal("widget::layout_changed")
        end
        
        -- Also update all screens to ensure shimmer is visible everywhere
        for s in screen do
            if s.mytaglist then s.mytaglist:emit_signal("widget::redraw_needed") end
            if s.mytasklist then s.mytasklist:emit_signal("widget::redraw_needed") end
        end
    end
end)

-- Additional signal handlers to ensure shimmer persistence
client.connect_signal("focus", function(c)
    -- Always restart shimmer animation when client focus changes
    start_shimmer_animation()
    
    -- Force immediate shimmer update
    if force_shimmer_update then
        force_shimmer_update()
    end
    
    -- Update the specific client in all tasklists
    if c and c.valid then
        for s in screen do
            if s.mytasklist then s.mytasklist:emit_signal("widget::redraw_needed") end
        end
    end
end)

-- Handle mouse button events to maintain shimmer
awful.button.connect_signal("press", function()
    gears.timer.delayed_call(function()
        if force_shimmer_update then
            force_shimmer_update()
        end
    end)
end)

-- Listen for shimmer updates
awesome.connect_signal("shimmer::update", function()
    -- Force redraw of taglist and tasklist when shimmer updates
    for s in screen do
        if s.mytaglist then s.mytaglist:emit_signal("widget::redraw_needed") end
        if s.mytasklist then s.mytasklist:emit_signal("widget::redraw_needed") end
    end
end)

-- Update shimmer effect when client focus changes
client.connect_signal("focus", function(c)
    -- Force redraw of tasklist when client focus changes
    if c and c.screen and c.screen.mytasklist then
        c.screen.mytasklist:emit_signal("widget::redraw_needed")
        
        -- Restart shimmer effect when client focus changes
        if shimmer and shimmer.restart then
            shimmer.restart()
        end
    end
end)


