-- Define shimmer colors to use - more distinct colors in the gold/orange family
local shimmer_colors = {
    "#FFFDE7", -- Very light gold
    "#FFF176", -- Light yellow
    "#FFD700", -- Gold
    "#FFA000", -- Amber
    "#FF8F00", -- Dark amber
    "#FF6F00", -- Deep amber
    "#F57F17"  -- Deep orange gold
}

-- Shimmer animation state
local shimmer_phase = 0
local shimmer_timer = nil

-- Global shimmer timer to ensure it isn't garbage collected
_G.shimmer_timer = nil

-- Function to start shimmer animation timer
local function start_shimmer_animation()
    if _G.shimmer_timer then _G.shimmer_timer:stop() end
    
    -- Create the timer with EXTREMELY fast interval for unmissable animation
    _G.shimmer_timer = gears.timer({
        timeout = 0.05,  -- Ultra-fast updates for unmistakable shimmer effect
        autostart = true,
        callback = function()
            -- Update phase with large increments for dramatic movement
            shimmer_phase = (shimmer_phase + 3) % 100
            
            -- Force full redraw of ALL widgets on ALL screens
            for s in screen do
                if s.mywibox then 
                    s.mywibox:emit_signal("widget::redraw_needed")
                end
                if s.mytaglist then 
                    s.mytaglist:emit_signal("widget::redraw_needed") 
                    s.mytaglist:emit_signal("widget::layout_changed")
                end
                if s.mytasklist then 
                    s.mytasklist:emit_signal("widget::redraw_needed")
                    s.mytasklist:emit_signal("widget::layout_changed") 
                end
            end
            
            -- Trigger an extra immediate redraw for the active screen
            if screen.primary and screen.primary.mytaglist then
                screen.primary.mytaglist:emit_signal("widget::redraw_needed")
            end
            
            return true -- Keep the timer running
        end
    })
    
    -- Start the timer silently
    _G.shimmer_timer:start()
end

-- Early helpers (must come before widgets that call them)
-- Expose shimmer text application globally so taglist/tasklist templates can call it during creation
function apply_shimmer_to_widget(widget, text, status_symbols)
    if not widget or not widget.set_markup then return end
    
    -- Make sure text has content
    local prefix = status_symbols or ""
    text = text or ""
    if text == "" then text = " " end
    
    -- Use EXTREME high-contrast neon colors for unmissable visibility
    local vivid_colors = {
        "#FFFFFF", -- Pure white
        "#00FFFF", -- Neon cyan
        "#FF00FF", -- Neon magenta
        "#FFFF00", -- Neon yellow
        "#00FF00", -- Neon green
        "#FF0000"  -- Neon red
    }
    
    -- Reset any parent stylings first to prevent theme inheritance
    if widget.set_bg and widget.set_fg then
        -- Force parent widget to have transparent background
        widget:set_bg("transparent")
        -- Reset foreground color
        widget:set_fg(nil)
    end
    
    -- Create shimmer markup with extra-strong contrast
    local markup = ''
    
    -- Add the status prefix if any
    if prefix and prefix ~= "" then
        markup = markup .. '<span color="#FFFFFF" bgcolor="#000000">' .. prefix .. '</span>'
    end
    
    -- Apply black background to entire text for maximum contrast
    markup = markup .. '<span background="#000000" underline="none" strikethrough="false" italic="false">'
    
    -- Process each character with highly visible effect
    for i = 1, #text do
        local char = text:sub(i, i)
        
        -- Calculate color index based on position and phase
        local color_idx = ((i + shimmer_phase) % #vivid_colors) + 1
        local color = vivid_colors[color_idx]
        
        -- Apply maximum visibility styling with bold, large text on black background
        markup = markup .. '<span color="' .. color .. '" bgcolor="#000000"><b>' .. char .. '</b></span>'
    end
    
    -- Close all spans
    markup = markup .. '</span>'
    
    -- Force markup application and bypass any theme overrides
    widget:set_markup(markup)
    
    -- Mark widget as shimmer-applied to prevent other style changes
    widget.__shimmer_applied = true
end

-- Expose client status prefix globally so tasklist update callbacks can use it during initial render
function get_client_status_prefix(c)
    if not c or not c.valid then return "" end

    local symbols = {}
    if c.floating then table.insert(symbols, "✈") end
    if c.maximized then
        table.insert(symbols, "+")
    elseif c.maximized_horizontal then
        table.insert(symbols, "⬌")
    elseif c.maximized_vertical then
        table.insert(symbols, "⬍")
    end
    if c.sticky then table.insert(symbols, "▪") end
    if c.ontop then
        table.insert(symbols, "⌃")
    elseif c.above then
        table.insert(symbols, "▴")
    elseif c.below then
        table.insert(symbols, "▾")
    end

    -- Use a non-breaking space as separator to keep layout stable
    return #symbols > 0 and (table.concat(symbols, "") .. " ") or ""
end


