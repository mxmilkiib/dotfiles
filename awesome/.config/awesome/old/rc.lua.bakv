-- Simple function to show layout change notification after awful.layout.inc
local function notify_layout_change()
    -- Get current layout information
    local layout_name = awful.layout.getname() or "unknown"
    
    -- Find the current layout index
    local s = awful.screen.focused()
    local current_layout = awful.layout.get(s)
    local current_index = 1
    
    for i, layout in ipairs(awful.layout.layouts) do
        if layout == current_layout then
            current_index = i
            break
        end
    end
    
    -- Show informative notification
    naughty.notify({
        title = "Layout Changed",
        text = layout_name .. " (" .. current_index .. "/" .. #awful.layout.layouts .. ")",
        timeout = 1
    })
end

-- Create the debug cycle layouts function at global level for keyboard shortcuts
local function debug_cycle_layouts_global(increment)
    local s = mouse.screen or awful.screen.focused()
    local old_layout = awful.layout.get(s)
    local old_index = 0
    
    -- Find current layout index
    for i, layout in ipairs(awful.layout.layouts) do
        if layout == old_layout then
            old_index = i
            break
        end
    end
    
    -- Calculate next layout index with manual wrapping
    local new_index = old_index + increment
    if new_index > #awful.layout.layouts then new_index = 1 end
    if new_index < 1 then new_index = #awful.layout.layouts end
    
    -- Set the layout manually
    local new_layout = awful.layout.layouts[new_index]
    awful.layout.set(new_layout, s.selected_tag or s.tags[1])
    
    -- Show detailed debugging info
    naughty.notify({
        title = "Layout Change Debug",
        text = string.format("From: %s (#%d)\nTo: %s (#%d)\nDirection: %s\nTotal layouts: %d", 
                      awful.layout.getname(old_layout) or "unknown", old_index,
                      awful.layout.getname(new_layout) or "unknown", new_index,
                      increment > 0 and "forward" or "backward",
                      #awful.layout.layouts),
        timeout = 3
    })
end

-- Awesome control and layout keybindings
globalkeys = gears.table.join(globalkeys,
    awful.key({ modkey }, "r", function()
