        end, { description = "Denon amp decrease volume", group = "hardware" }),
    awful.key({modkey, ctrlkey, altkey}, "v", function()
        awful.util.spawn("funiculi --host 192.168.1.24 mute", false)
        end, { description = "Denon amp mute toggle", group = "hardware" }),

    -- Media transport (Winamp-style + XF86)
