-- Tag hover text helper: keep text white unless selected; apply temporary hover color
function apply_tag_hover_text(text_widget, t, entering)
    if not text_widget or not text_widget.set_markup or not t or not t.valid then return end
    if t.selected then return end
    local current = t.name or ''
    if entering then
        local col = beautiful.taglist_hover_fg or "#FFD700"
        text_widget:set_markup('<span color="' .. col .. '">' .. current .. '</span>')
        text_widget.__hover_text_colored = true
    else
        if text_widget.__hover_text_colored then
            text_widget:set_markup('<span color="#FFFFFF">' .. current .. '</span>')
            text_widget.__hover_text_colored = nil
        end
    end
end


