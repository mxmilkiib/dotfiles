-- Define default terminal and editor
terminal = "urxvt"
-- terminal = "alacritty"
editor = os.getenv("EDITOR") or "nvim"
editor_cmd = terminal .. " -e " .. editor

-- Compound terminal command for system monitoring
terminal_cmd = terminal .. " -e btop;" .. terminal .. " -e journalctl -xeb;" .. terminal .. " -e dmesg"

-- Forward declare generated terminal icon helper so earlier functions can reference it
local create_terminal_icon_surface

-- Check if client has a valid icon (not nil, not tiny/invalid)
local function client_has_valid_icon(c)
    if not c or not c.valid or not c.icon then return false end
    local ok, surf = pcall(gears.surface, c.icon)
    if not ok or not surf then return false end
    local w, h = 0, 0
    local okw, valw = pcall(function() return surf:get_width() end)
    if okw and type(valw) == 'number' then w = valw end
    local okh, valh = pcall(function() return surf:get_height() end)
    if okh and type(valh) == 'number' then h = valh end
    return (w or 0) > 1 and (h or 0) > 1
end

-- Terminal classes that should get generic icons
local terminal_classes = {
    URxvt = true, urxvt = true,
    XTerm = true, xterm = true,
    Alacritty = true, alacritty = true,
    Kitty = true, kitty = true,
    foot = true, Foot = true,
    ["st-256color"] = true, st = true,
    WezTerm = true, wezterm = true,
    Ghostty = true, ghostty = true,
}

-- Assign generic terminal icon for terminal clients at manage time
client.connect_signal("manage", function(c)
    if c and c.class and terminal_classes[c.class] and not client_has_valid_icon(c) then
        local term_icon = gears.filesystem.get_configuration_dir() .. "milktheme/layouts/term.png"
        if gears.filesystem.file_readable(term_icon) then
            c.icon = term_icon
        elseif create_terminal_icon_surface then
            c.icon = create_terminal_icon_surface(16)
        end
    end
end)

-- Generic fallback icon for tasklist: use terminal icon when client has no or invalid icon
local GENERIC_TASK_ICON = gears.filesystem.get_configuration_dir() .. "milktheme/layouts/term.png"

local function apply_generic_task_icon(self, c)
    if not self or not c or not c.valid then return end
    local icon_widget = self:get_children_by_id('icon_role')[1]
    if not icon_widget then return end
    -- Only apply when the client truly has no/invalid icon
    if not client_has_valid_icon(c) then
        if gears.filesystem.file_readable(GENERIC_TASK_ICON) then
            icon_widget.image = GENERIC_TASK_ICON
        else
            -- Fallback to a generated vector-like terminal icon surface
            if create_terminal_icon_surface then
                icon_widget.image = create_terminal_icon_surface(16)
            end
        end
    end
end

-- When a client later provides an icon, refresh tasklists so the real icon shows up
client.connect_signal("property::icon", function(c)
    if not (c and c.valid and c.screen) then return end
    local s = c.screen
    if s.mytasklist then s.mytasklist:emit_signal("widget::redraw_needed") end
    if s.myalltasklist then s.myalltasklist:emit_signal("widget::redraw_needed") end
end)

-- Forward declaration: ensure set_wallpaper exists before first use
local set_wallpaper

-- Early definition so callbacks can call it immediately
set_wallpaper = function(s)
    if beautiful.wallpaper then
        local wallpaper = beautiful.wallpaper
        if type(wallpaper) == "function" then wallpaper = wallpaper(s) end
        gears.wallpaper.maximized(wallpaper, s, true)
    end
end




