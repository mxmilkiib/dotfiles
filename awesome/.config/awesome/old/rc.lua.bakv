-- Drawing utils (needed before taglist setup): Cairo + square surface generator
local cairo = require("lgi").cairo

function create_square_surface(filled, size)
    -- Default to theme-provided size to keep UI consistent
    size = size or (beautiful and beautiful.tag_square_size) or 7
    size = math.max(1, math.floor(size + 0.5))

    local img = cairo.ImageSurface(cairo.Format.ARGB32, size, size)
    local cr = cairo.Context(img)

    if filled then
        cr:set_source_rgba(0.7, 0.7, 0.7, 1)
        cr:rectangle(0, 0, size, size)
        cr:fill()
    else
        cr:set_source_rgba(0.5, 0.5, 0.5, 1)
        cr:set_line_width(1.0)
        -- Pixel-aligned stroke for crisp edges
        cr:rectangle(0.5, 0.5, size - 1.0, size - 1.0)
        cr:stroke()
    end

    return img
end

