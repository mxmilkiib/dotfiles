-- Layout icon pack switching (PNG <-> SVG)
local LAYOUT_ICON_PACK = "svg"
local function apply_layout_icons(mode)
    local themes_dir = gears.filesystem.get_themes_dir()
    local extras = beautiful.extras_icons or (gears.filesystem.get_configuration_dir() .. "lib_extras_milkii/icons/layouts/")
    local suffix = (beautiful.layout_icon_config and beautiful.layout_icon_config.current_suffix) or "_alt"
    
    -- Debug function to check if a file exists
    local function file_exists(name)
        local f = io.open(name, "r")
        if f then io.close(f) return true else return false end
    end
    
    -- Enhanced png function with validation
    local function png(name) 
        local path = themes_dir .. "default/layouts/" .. name .. "w.png"
        if not file_exists(path) then
            naughty.notify({ title = "Icon Missing", text = "PNG icon not found: " .. path, timeout = 3 })
        end
        return path
    end
    
    local function svg(name) 
        local path = extras .. name .. suffix .. ".svg"
        if not file_exists(path) then
            -- Don't notify - will use PNG fallback
            return nil
        end
        return path
    end

    -- Force standard layouts to always use PNG icons
    -- These are from the core awesome distribution and should always work
    beautiful.layout_fairh = png("fairh")
    beautiful.layout_fairv = png("fairv")
    beautiful.layout_floating = png("floating")
    beautiful.layout_magnifier = png("magnifier")
    beautiful.layout_max = png("max")
    beautiful.layout_fullscreen = png("fullscreen")
    beautiful.layout_tilebottom = png("tilebottom")
    beautiful.layout_tileleft = png("tileleft")
    beautiful.layout_tile = png("tile")
    beautiful.layout_tiletop = png("tiletop")
    beautiful.layout_spiral = png("spiral")
    beautiful.layout_dwindle = png("dwindle")
    beautiful.layout_cornernw = png("cornernw")
    beautiful.layout_cornerne = png("cornerne")
    beautiful.layout_cornersw = png("cornersw")
    beautiful.layout_cornerse = png("cornerse")
    
    -- Custom layouts - use PNG fallbacks but try SVG if requested
    beautiful.layout_treetile = png("tile")              -- Use standard tile for treetile
    beautiful.layout_equalarea = png("fairh")            -- Use fairh for equalarea
    beautiful.layout_deck = png("max")                  -- Use max for deck
    beautiful.layout_mstab = png("tileleft")            -- Use tileleft for mstab
    beautiful.layout_centered = png("floating")         -- Use floating for centered
    beautiful.layout_cascade = png("tilebottom")        -- Use tilebottom for cascade
    beautiful.layout_centerwork_adaptiveh = png("tile") -- Use tile for centerwork_adaptiveh
    beautiful.layout_centerwork_twothirdsh = png("tile") -- Use tile for centerwork_twothirdsh

    -- Try to use SVG icons only for custom layouts if requested
    if mode == "svg" then
        -- Create a lookup table to check if an SVG exists
        local svg_paths = {}
        
        -- Try loading each SVG and store the path if it exists
        local custom_layouts = {
            "cascade", "treetile", "equalarea", "deck", "mstab", 
            "centered", "centerwork_adaptiveh", "centerwork_twothirdsh"
        }
        
        for _, name in ipairs(custom_layouts) do
            local svg_path = svg(name)
            if svg_path then
                svg_paths[name] = svg_path
            end
        end
        
        -- Apply SVG icons only if they exist
        for name, path in pairs(svg_paths) do
            beautiful["layout_" .. name] = path
        end
        
        -- Debug notification to show which icons are available
        local svg_count = 0
        for _ in pairs(svg_paths) do svg_count = svg_count + 1 end
        
        naughty.notify({ 
            title = "Layout Icons", 
            text = svg_count .. " SVG icons found and applied. Standard layouts use PNG.", 
            timeout = 3 
        })
    end

    LAYOUT_ICON_PACK = mode
    -- refresh layout boxes
    for s in screen do
        if s.mylayoutbox then s.mylayoutbox:emit_signal("widget::redraw_needed") end
    end
end

-- Initialize to SVG to match theme
gears.timer.delayed_call(function() pcall(apply_layout_icons, "svg") end)

-- Add a dedicated shimmer update function to explicitly apply shimmer to all widgets
function force_shimmer_update()
    -- Apply shimmer to all tag text widgets on all screens
    for s in screen do
        if s.mytaglist then
            -- Add pcall to safely handle potential errors
            local success, tags = pcall(function() return s.mytaglist:get_children() end)
            if success and tags then
                for _, tag_widget in ipairs(tags) do
                    -- Skip invalid widgets
                    if not tag_widget or type(tag_widget) ~= "table" or not tag_widget.get_children_by_id then
                        goto continue
                    end
                    
                    local text_widget = tag_widget:get_children_by_id("text_role")[1]
                    if text_widget and apply_shimmer_to_widget then
                        local tag_obj = tag_widget._tag
                        local tag_name = tag_obj and tag_obj.name or ""
                        apply_shimmer_to_widget(text_widget, tag_name)
                        
                        -- Make sure text isn't hidden by theme settings
                        tag_widget.fg = nil
                    end
                    ::continue::
                end
            end
        end
        
        -- Apply to tasklist items too
        if s.mytasklist then
            -- Add pcall to safely handle potential errors
            local success, tasks = pcall(function() return s.mytasklist:get_children() end)
            if success and tasks then
                for _, task_widget in ipairs(tasks) do
                    -- Skip invalid widgets
                    if not task_widget or type(task_widget) ~= "table" or not task_widget.get_children_by_id then
                        goto continue_task
                    end
                    
                    local text_widget = task_widget:get_children_by_id("text_role")[1]
                    if text_widget and apply_shimmer_to_widget then
                        local client = task_widget._client
                        if client and client.valid then
                            apply_shimmer_to_widget(text_widget, client.name or client.class or "")
                            
                            -- Ensure foreground isn't overridden
                            task_widget.fg = nil
                        end
                    end
                    ::continue_task::
                end
            end
        end
    end
    
    -- Apply shimmer to launcher text again
    if launcher_text and apply_shimmer_to_widget then
        apply_shimmer_to_widget(launcher_text, "⚙")
    end
    
    -- Force redraw of all widgets
    for s in screen do
        if s.mywibox then s.mywibox:emit_signal("widget::redraw_needed") end
    end
end

-- AGGRESSIVE periodic refresh - set multiple timers with different periods
-- This creates a staggered refresh pattern that makes it very hard for text to disappear

-- Very quick refresh timer (0.1s)
_G.shimmer_refresh_timer_quick = gears.timer({
    timeout = 0.1,
    autostart = true,
    call_now = true,
    callback = function()
        -- Just trigger widget redraw signals without full refresh
        for s in screen do
            if s.mytaglist then s.mytaglist:emit_signal("widget::redraw_needed") end
            if s.mytasklist then s.mytasklist:emit_signal("widget::redraw_needed") end
        end
    end
})

-- Medium refresh timer (0.25s)
_G.shimmer_refresh_timer_med = gears.timer({
    timeout = 0.25, 
    autostart = true,
    call_now = true,
    callback = force_shimmer_update
})

-- Slower but thorough refresh (1.0s)
_G.shimmer_refresh_timer_slow = gears.timer({
    timeout = 1.0,
    autostart = true,
    call_now = true,
    callback = function()
        -- Full force refresh
        force_shimmer_update()
        
        -- Rebuild all widgets if needed
        for s in screen do
            if s.mytaglist then s.mytaglist:emit_signal("widget::layout_changed") end
            if s.mytasklist then s.mytasklist:emit_signal("widget::layout_changed") end
        end
    end
})

-- Force shimmer to start immediately on config load (make sure it's always running)
gears.timer.delayed_call(function() 
    -- First force stop any existing timers
    if _G.shimmer_timer then 
        _G.shimmer_timer:stop() 
        _G.shimmer_timer = nil
    end
    
    -- Start with a clean slate
    shimmer_phase = 0
    
    -- Start the shimmer animation with full force
    start_shimmer_animation()
    
    -- Force immediate shimmer update on all widgets
    force_shimmer_update()
    
    -- Force immediate redraw of all screens to show shimmer
    for s in screen do
        if s.mywibox then s.mywibox:emit_signal("widget::redraw_needed") end
        if s.mytaglist then s.mytaglist:emit_signal("widget::redraw_needed") end
        if s.mytasklist then s.mytasklist:emit_signal("widget::redraw_needed") end
    end
end)

