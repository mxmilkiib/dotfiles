-- restore and cycle minimized windows

globalkeys = gears.table.join(globalkeys,
    -- Client restore keybinding
    awful.key({ modkey, ctrlkey }, "n", function() 
        local c = awful.client.restore()
        if c then
            c:emit_signal("request::activate", "key.unminimize", {raise = true})
        end
        end, { description = "restore minimized", group = "client" }),
    
    -- Restore all minimized windows
    awful.key({ modkey, altkey }, ";", function() 
        for _, c in ipairs(client.get()) do
            if c.minimized then
                c.minimized = false
                -- Activate via signal for compatibility across Awesome versions
                c:emit_signal("request::activate", "restore_all", { raise = true })
                c:raise()
            end
        end
        end, { description = "restore all minimized windows", group = "client" }),

    -- Cycle through minimized windows 
    awful.key({ modkey }, ";", function()
        if client.focus then
            local c = client.focus
            local nxt = nil
            for x in awful.client.iterate(function(x) return x.minimized end) do
                if nxt then
                    nxt:swap(x)
                else
                    nxt = x
                end
            end
            c.minimized = true
            if nxt then
                nxt.minimized = false
                c:swap(nxt)
                client.focus = nxt
                nxt:raise()
            end
        end
        end, { description = "cycle minimized windows", group = "client" })
)

