-- Additional client keybindings


globalkeys = gears.table.join(globalkeys,
    -- Close window
    awful.key({ modkey }, "w", function() 
        if client.focus then client.focus:kill() end
        end, { description = "close window", group = "client" }),
        
    -- Add focused window to floating rules (non-interactive)
    awful.key({ modkey, ctrlkey, shiftkey }, "f", function()
        awful.spawn.with_shell("~/dotfiles/awesome/.config/awesome/add-floating-rule.sh")
        end, { description = "add focused window to floating rules", group = "awesome" }),

    -- Focus next by index
    awful.key({ modkey }, "j", function() awful.client.focus.byidx(1) end,
        { description = "focus next by index", group = "client" }),

    -- Focus previous by index
    awful.key({ modkey }, "k", function() awful.client.focus.byidx(-1) end,
        { description = "focus previous by index", group = "client" }),

    -- Jump to urgent client
    awful.key({ modkey }, "u", awful.client.urgent.jumpto,
        { description = "jump to urgent client", group = "client" }),

    -- Go back (focus history)
    awful.key({ modkey }, "Tab", function()
        awful.client.focus.history.previous()
        if client.focus then client.focus:raise() end
        end, { description = "go back", group = "client" }),

    -- Cycle through clients (Alt+Tab forward/back)
    awful.key({ altkey }, "Tab", function() cyclefocus.cycle({modifier = "Alt_L"}) end,
        { description = "cycle through clients", group = "client" }),
    awful.key({ altkey, shiftkey }, "Tab", function() cyclefocus.cycle({modifier = "Alt_L"}) end,
        { description = "cycle backward through clients", group = "client" }),

    -- Also provide Super+Ctrl+Tab variants for cyclefocus
    awful.key({ modkey, ctrlkey }, "Tab", function() cyclefocus.cycle({modifier = "Super_L"}) end,
        { description = "cycle through clients (super+ctrl)", group = "client" }),
    awful.key({ modkey, ctrlkey, shiftkey }, "Tab", function() cyclefocus.cycle({modifier = "Super_L"}) end,
        { description = "cycle backward through clients (super+ctrl)", group = "client" }),

    -- (duplicate removed) Cycle minimized is defined in RESTORE MIN section


    -- Toggle floating window to the corner (manual variant)
    awful.key({ modkey, ctrlkey, shiftkey }, "w", function()
        local c = client.focus
        if not c then return end
        if c.floating then
            c.floating = false
            c.ontop = false
            c.sticky = false
        else
            c.floating = true
            c.ontop = true
            c.sticky = true
            c.width = 633
            c.height = 400
            awful.placement.top_right(client.focus)
        end
        end, { description = "ontop floating right corner (manual)", group = "client" }),

    -- Toggle floating window to the corner
    -- Removed duplicate: Mod+Shift+w simple toggle; using smart variant defined later as
    -- "ontop floating right corner (smart)"

    awful.key({ modkey, shiftkey }, "j", function() 
        awful.client.swap.byidx(1)
        end, { description = "swap with next client by index", group = "client" }),
    awful.key({ modkey, shiftkey }, "k", function() 
        awful.client.swap.byidx(-1)
        end, { description = "swap with previous client by index", group = "client" }),

    -- Minimize current window
    awful.key({ modkey }, "n", function()
        local c = client.focus
        if not c then return end
        -- The client currently has the input focus, so it cannot be
        -- minimized, since minimized clients can't have the focus.
        c.minimized = true
        end, { description = "minimize", group = "client" }),
    
    -- Jump to window
    awful.key({ modkey, shiftkey }, "n", function() 
        awful.util.spawn("/home/milk/bin/rofi_jumpwindow")
        end, { description = "jump to window", group = "client" }),
    
    -- Maximise toggle for current window
    awful.key({ modkey }, "m", function()
        local c = client.focus
        if not c then return end
        c.maximized = not c.maximized
        c:raise()
        end, { description = "(un)maximize", group = "client" }),

    -- Maximise vertically toggle for current window
    awful.key({ modkey, ctrlkey }, "m", function()
        local c = client.focus
        if not c then return end
        c.maximized_vertical = not c.maximized_vertical
        c:raise()
        end, { description = "(un)maximize vertically", group = "client" }),

    -- Maximise horizontally toggle for current window
    awful.key({ modkey, shiftkey }, "m", function()
        local c = client.focus
        if not c then return end
        c.maximized_horizontal = not c.maximized_horizontal
        c:raise()
        end, { description = "(un)maximize horizontally", group = "client" }),

    -- Centre a floating window
    awful.key({ modkey, shiftkey }, "z", function()
        local c = client.focus
        if not c then return end
        awful.placement.centered(c)
        end, { description = "centre floating window", group = "client" }),

    -- Make a window floating and centre it for zen reading experience
    awful.key({ modkey }, "a", function()
        local c = client.focus
        if not c then return end
        c.floating = not c.floating
        c.width = c.screen.geometry.width * 3 / 5
        c.x = c.screen.geometry.x + (c.screen.geometry.width / 5)
        c.height = c.screen.geometry.height * 0.93
        c.y = c.screen.geometry.height * 0.04
        end, { description = "large centre floating window", group = "client" }),

    -- Toggle window on-top
    awful.key({ modkey }, "t", function()
        local c = client.focus
        if not c then return end
        c.ontop = not c.ontop
        end, { description = "toggle window on-top", group = "client" }),

    -- Send window to the behind plane
    awful.key({ modkey }, "comma", function()
        local c = client.focus
        if not c then return end
        c.below = not c.below
        end, { description = "behind", group = "client" }),

    -- Send window to the above plane
    awful.key({ modkey }, "slash", function()
        local c = client.focus
        if not c then return end
        c.above = not c.above
        end, { description = "above", group = "client" }),

    -- Sticky window, stays on all tags
    awful.key({ modkey }, "x", function()
        local c = client.focus
        if not c then return end
        c.sticky = not c.sticky
        end, { description = "toggle sticky", group = "client" }),


    -- Layout management keybindings
    awful.key({ modkey }, "l", function()
        awful.tag.incmwfact(0.05)
        end, { description = "increase master width factor", group = "layout" }),

    awful.key({ modkey }, "h", function()
        awful.tag.incmwfact(-0.05)
        end, { description = "decrease master width factor", group = "layout" }),

    awful.key({ modkey, shiftkey }, "h", function()
