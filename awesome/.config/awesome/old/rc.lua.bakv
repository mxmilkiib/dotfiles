-- // MARK: tasklist
-- create tasklist for each screen


-- Prefer per-screen setup to avoid zero-width/geometry issues
SETUP_PER_SCREEN = true
-- Simple fallbacks to guarantee visibility while debugging
USE_SIMPLE_TAGLIST = true
-- Simple fallbacks to guarantee visibility while debugging
USE_SIMPLE_TASKLIST = true
-- Experimental: create an alternate minimal wibar (hidden by default)
ENABLE_ALT_WIBAR = false

-- Tasklist filter mode: false = currenttags (default), true = alltags
TASKLIST_SHOW_ALL_TAGS = false

-- Build a tasklist for a screen, honoring the current filter mode and simplicity flag
local function build_tasklist_for_screen(s)
    local filter = TASKLIST_SHOW_ALL_TAGS and awful.widget.tasklist.filter.alltags
                                    or awful.widget.tasklist.filter.currenttags
    if USE_SIMPLE_TASKLIST then
        return awful.widget.tasklist {
            screen = s,
            filter = filter,
            buttons = tasklist_buttons,
            layout = { spacing = 1, layout = wibox.layout.fixed.horizontal },
            widget_template = {
                {
                    {
                        {
                            { id = 'icon_role', forced_width = 16, forced_height = 16, resize = true, widget = wibox.widget.imagebox },
                            left = 6,
                            widget = wibox.container.margin
                        },
                        { id = 'text_role', widget = wibox.widget.textbox },
                        spacing = 4,
                        layout = wibox.layout.fixed.horizontal
                    },
                    valign = 'center',
                    halign = 'left',
                    widget = wibox.container.place
                },
                left = 6, right = 6, top = 2, bottom = 2,
                widget = wibox.container.margin,
                id = 'background_role',
                widget = wibox.container.background,
                create_callback = function(self, c)
                    apply_generic_task_icon(self, c)
                    -- Set purple background only for focused client
                    if c and c.valid and client.focus and c.window == client.focus.window then
                        self:set_bg(beautiful.main_purple or "#663399")
                    else
                        self:set_bg(nil)
                    end
                end,
                update_callback = function(self, c)
                    apply_generic_task_icon(self, c)
                    -- Update background and text based on focus state
                    if c and c.valid and client.focus and c.window == client.focus.window then
                        self:set_bg(beautiful.main_purple or "#663399")
                        local text_widget = self:get_children_by_id('text_role')[1]
                        if text_widget then
                            -- Apply shimmer to focused client
                            if apply_shimmer_to_widget then
                                apply_shimmer_to_widget(text_widget, c.name or c.class or "", nil)
                            end
                        end
                    else
                        self:set_bg(nil)
                        local text_widget = self:get_children_by_id('text_role')[1]
                        if text_widget then
                            -- Regular white text for non-focused clients
                            text_widget:set_markup('<span color="white">' .. (c.name or c.class or "") .. '</span>')
                        end
                    end
                end
            }
        }
    else
        return awful.widget.tasklist {
            screen = s,
            filter = filter,
            buttons = tasklist_buttons,
            style = { bg_normal = nil, bg_focus = nil, bg_minimize = nil, bg_urgent = nil },
            layout = { spacing = 1, layout = wibox.layout.fixed.horizontal },
            widget_template = {
                {
                    {
                        {
                            { id = 'icon_role', forced_width = 16, forced_height = 16, resize = true, widget = wibox.widget.imagebox },
                            left = 6,
                            widget = wibox.container.margin
                        },
                        { id = 'text_role', widget = wibox.widget.textbox },
                        spacing = 4,
                        layout = wibox.layout.fixed.horizontal
                    },
                    valign = 'center',
                    halign = 'left',
                    widget = wibox.container.place
                },
                left = 6, right = 6, top = 2, bottom = 2,
                widget = wibox.container.margin,
                id = 'background_role',
                widget = wibox.container.background,
                create_callback = function(self, c)
                    apply_generic_task_icon(self, c)
                    -- Set purple background only for focused client
                    if c and c.valid and client.focus and c.window == client.focus.window then
                        self:set_bg(beautiful.main_purple or "#663399")
                    else
                        self:set_bg(nil)
                    end
                end,
                update_callback = function(self, c)
                    apply_generic_task_icon(self, c)
                    -- Update background and text based on focus state
                    if c and c.valid and client.focus and c.window == client.focus.window then
                        self:set_bg(beautiful.main_purple or "#663399")
                        local text_widget = self:get_children_by_id('text_role')[1]
                        if text_widget then
                            -- Apply shimmer to focused client
                            if apply_shimmer_to_widget then
                                apply_shimmer_to_widget(text_widget, c.name or c.class or "", nil)
                            end
                        end
                    else
                        self:set_bg(nil)
                        local text_widget = self:get_children_by_id('text_role')[1]
                        if text_widget then
                            -- Regular white text for non-focused clients
                            text_widget:set_markup('<span color="white">' .. (c.name or c.class or "") .. '</span>')
                        end
                    end
                end
            }
        }
    end
end

-- Rebuild tasklist for a screen and re-apply the center section of the bar
local function rebuild_tasklist_and_bar_center(s)
    if not s then return end
    s.mytasklist = build_tasklist_for_screen(s)
    if s.mywibox then
        -- Use the standard wibar layout if available, otherwise create a new one
        if s.standard_wibar_setup then
            -- Update just the mytasklist element in the stored setup
            s.standard_wibar_setup[2] = s.mytasklist
            s.mywibox:setup(s.standard_wibar_setup)
        else
            -- Fallback to direct layout creation (without duplicate taglist)
            s.mywibox:setup{
                layout = wibox.layout.align.horizontal,
                { layout = wibox.layout.fixed.horizontal, mylauncher, s.mypromptbox, {
                    s.mylayoutbox_container, -- Purple layout widget with margins
                    left   = 4,
                    right  = 4,
                    top    = 4,
                    bottom  = 4,
                    widget = wibox.container.margin
                } },
                s.mytasklist,
                { layout = wibox.layout.fixed.horizontal, s.textclock_clr or wibox.widget.textclock(), wibox.widget.systray() }
            }
        end
    end
end




-- add a titlebar if titlebars_enabled is set to true in the rules
client.connect_signal("request::titlebars", function(c)
    -- buttons for the titlebar
    local buttons = gears.table.join(awful.button({}, 1, function()
        c:emit_signal("request::activate", "titlebar", {raise = true})
        awful.mouse.client.move(c)
    end), awful.button({}, 3, function()
        c:emit_signal("request::activate", "titlebar", {raise = true})
        awful.mouse.client.resize(c)
    end))

    awful.titlebar(c):setup{
        { -- Left
            awful.titlebar.widget.iconwidget(c),
            buttons = buttons,
            layout = wibox.layout.fixed.horizontal
        },
        { -- Middle
            { -- Title
                align = "center",
                widget = awful.titlebar.widget.titlewidget(c)
            },
            buttons = buttons,
            layout = wibox.layout.flex.horizontal
        },
        { -- Right
            awful.titlebar.widget.floatingbutton(c),
            awful.titlebar.widget.maximizedbutton(c),
            awful.titlebar.widget.stickybutton(c),
            awful.titlebar.widget.ontopbutton(c),
            awful.titlebar.widget.closebutton(c),
            layout = wibox.layout.fixed.horizontal()
        },
        layout = wibox.layout.align.horizontal
    }
end)




-- // MARK: WIBOX BAR
-- hotkeys for managing the visibility and behavior of status bars and widgets


-- Helper: ensure a wibar exists for a given screen (opportunistic creation)
function ensure_wibar_for_screen(s)
    if not s then return nil end
    if s.mywibox then
        return s.mywibox
    end
    
    -- Create minimal wibar if it doesn't exist
    s.textclock_clr = wibox.container.background(wibox.widget.textbox())
    local mytextclock = wibox.widget.textclock()
    mytextclock.format = "%a %b %d  %H:%M"
    s.textclock_clr:set_widget(wibox.container.margin(mytextclock, 4, 4, 0, 0))
    s.textclock_clr:set_fg("#ffffff")
    s.textclock_clr:set_bg(beautiful.main_purple or beautiful.bg_focus)

    -- Skip wibar creation entirely if it already exists
    if not s.mywibox then
        s.mywibox = awful.wibar({
            position = "top",
            screen = s,
            height = 28,
            bg = "#222222",
            fg = "#DDDDDD"
        })
    end
    
    -- Create a standard setup for this screen (without duplicate taglist)
    s.standard_wibar_setup = {
        layout = wibox.layout.align.horizontal,
        { layout = wibox.layout.fixed.horizontal,
          mylauncher,
          -- s.mytaglist removed to prevent duplicate
          s.mypromptbox,
          {
            s.mylayoutbox_container, -- Purple layout widget with margins
            -- left   = 4,
            -- right  = 4,
            -- top    = 4,
            -- bottom = 4,
            widget = wibox.container.margin
          },
          -- Add 1px separator here
            {
            widget = wibox.widget.separator,
            orientation = "vertical",
            forced_width = 5,
            color = "#222222"
          } },
        s.mytasklist,
        { layout = wibox.layout.fixed.horizontal,
        s.textclock_clr,
        wibox.widget.systray() }
    }
    
    -- Apply the setup
    s.mywibox:setup(s.standard_wibar_setup)
    
    -- No debug notifications
    if s.mywibox and s.mywibox.struts then s.mywibox:struts({ top = 24 }) end
    return s.mywibox
end

globalkeys = gears.table.join(globalkeys, 
    -- statusbar visibility toggle - hides/shows statusbar and resizes window space accordingly
    awful.key({ modkey }, "v", function()
        local myscreen = awful.screen.focused()
        local bar = (myscreen and myscreen.mywibox) or ensure_wibar_for_screen(myscreen)
        if not bar then
            return
        end
        bar.visible = not bar.visible
        if bar.struts then
            if bar.visible then
                bar:struts({ top = bar.height or 24 })
            else
                bar:struts({ top = 0 })
            end
        end
        end, { description = "toggle statusbar", group = "awesome" }),

    -- wibox visibility toggle - hides/shows all wiboxes without resizing window space
    awful.key({ modkey, altkey }, "v", function()
        for s in screen do
            if not s.mywibox then ensure_wibar_for_screen(s) end
            if s.mywibox then s.mywibox.visible = not s.mywibox.visible end
            if s.myaltwibox then s.myaltwibox.visible = not s.myaltwibox.visible end
        end
        end, { description = "toggle wibox", group = "awesome" }),

    -- menubar launcher - shows the awesome menubar application launcher
    awful.key({ modkey, shiftkey }, "space", function() 
        menubar.show()
        end, { description = "show the menubar", group = "launcher" }))




