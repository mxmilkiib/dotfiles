-- SHIMMER HOTKEYS - control shimmer animation modes

globalkeys = gears.table.join(globalkeys, -- Shimmer control keys
    awful.key({ modkey, shiftkey, altkey }, "1", function() 
        if shimmer and shimmer.set_mode then shimmer.set_mode("candle") else awesome.emit_signal("shimmer::set_mode", "candle") end
        end, { description = "candle shimmer mode", group = "shimmer" }),

    awful.key({ modkey, shiftkey, altkey }, "2", function() 
        if shimmer and shimmer.set_mode then shimmer.set_mode("cloud") else awesome.emit_signal("shimmer::set_mode", "cloud") end
        end, { description = "cloud shimmer mode", group = "shimmer" }),
    
    awful.key({ modkey, shiftkey, altkey }, "3", function() 
        if shimmer and shimmer.set_mode then shimmer.set_mode("char_flicker") else awesome.emit_signal("shimmer::set_mode", "char_flicker") end
        end, { description = "character flicker shimmer mode", group = "shimmer" }),
    
    awful.key({ modkey, shiftkey, altkey }, "4", function() 
        if shimmer and shimmer.set_mode then shimmer.set_mode("border_sync") else awesome.emit_signal("shimmer::set_mode", "border_sync") end
        end, { description = "border sync shimmer mode", group = "shimmer" }),
    
    awful.key({ modkey, shiftkey, altkey }, "0", function() 
        if shimmer and shimmer.set_mode then shimmer.set_mode("off") else awesome.emit_signal("shimmer::set_mode", "off") end
        end, { description = "turn off shimmer", group = "shimmer" }),
    
    awful.key({ modkey, shiftkey, altkey }, "5", function() 
        if shimmer and shimmer.set_mode then shimmer.set_mode("deep_gold") else awesome.emit_signal("shimmer::set_mode", "deep_gold") end
        end, { description = "deep gold shimmer mode", group = "shimmer" })
    )


