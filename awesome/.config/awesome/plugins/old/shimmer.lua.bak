-- plugins/shimmer.lua
-- Unified shimmer animation system for AwesomeWM
-- Provides animated text effects and synchronized border animation
-- 
-- Features:
--   • Unified color palette system for text and borders
--   • Multiple animation presets (warm_light, bright_gold, candle, etc.)
--   • Simple configuration interface: shimmer.configure({preset = "warm_light"})
--   • Auto-integration with taglist, tasklist, launcher, and border animation
--   • Signal-based coordination with DnD and other plugins
--   • Self-contained - no external setup required

local gears = require("gears")
local awful = require("awful")

local M = {}

-- expose main functions directly (flattened API)
M.set_mode = nil  -- defined below
M.get_mode = nil  -- defined below  
M.get_color = nil -- defined below
M.configure = nil -- defined below
M.start = nil     -- defined below
M.stop = nil      -- defined below


-- // MARK: CONSTANTS AND CONFIGURATION

-- Base gold color palette
local base_gold = "#FFD700"

-- Current animation mode
local shimmer_mode = "warm_light"

-- Widget tracking system (per screen)
local active_tag_widgets = {}

-- Mode stack for temporary mode changes (e.g., during DnD)
local mode_stack = {}

-- Integration registrations
local integrations = {
    tasklist = { enabled = false, renderers = {} },
    dnd = { enabled = false, handlers = {} }
}

-- Plugin registry
local registered_plugins = {}

-- Color palette cache and generation
local color_palettes = {}
local palette_length = 100

-- Gradient generator function (adapted from border_animation)
local function makeColorGradient(frequency1, frequency2, frequency3, phase1, phase2, phase3, center, width, length)
    center = center or 200  -- lighter center
    width = width or 55     -- reduced width for lighter colors
    length = length or palette_length
    local palette = {}
    for i = 0, length - 1 do
        local r = math.floor(math.sin(frequency1 * i + phase1) * width + center)
        local g = math.floor(math.sin(frequency2 * i + phase2) * width + center)
        local b = math.floor(math.sin(frequency3 * i + phase3) * width + center)
        -- clamp values to valid range
        r = math.max(0, math.min(255, r))
        g = math.max(0, math.min(255, g))
        b = math.max(0, math.min(255, b))
        palette[i] = string.format("#%02x%02x%02x", r, g, b)
    end
    return palette
end

-- Enhanced shimmer configuration with color cycling
