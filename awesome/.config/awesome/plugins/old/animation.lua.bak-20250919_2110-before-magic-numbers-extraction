-- // MARK: COLOUR PROG

-- calculate color progression phase offset for a character
local function get_color_progression_offset(char_index, total_chars, colour_prog_mode, text_seed)
    if colour_prog_mode == "colour_prog_off" or colour_prog_mode == "uniform" then
        return 0 -- no phase offset
    end
    
    local offset = 0
    
    if colour_prog_mode == "wave" then
        offset = (char_index - 1) * 0.4
    elseif colour_prog_mode == "reverse_wave" then
        offset = (total_chars - char_index + 1) * 0.4
    elseif colour_prog_mode == "sine_wave" then
        offset = math.sin((char_index - 1) * 0.6) * 4.0
    elseif colour_prog_mode == "center_out" then
        local center = (total_chars + 1) / 2
        local distance = math.abs(char_index - center)
        offset = distance * 0.8
    elseif colour_prog_mode == "edges_in" then
        local center = (total_chars + 1) / 2
        local distance_from_edge = math.min(char_index - 1, total_chars - char_index)
        offset = distance_from_edge * 0.6
    elseif colour_prog_mode == "pulse" then
        local pulse_freq = 0.5
        offset = math.sin((char_index - 1) * pulse_freq) * 3.0
    elseif colour_prog_mode == "alternating" then
        offset = (char_index % 2 == 0) and 6.0 or 0
    elseif colour_prog_mode == "fibonacci" then
        local function fib(n)
            if n <= 1 then return n end
            local a, b = 0, 1
            for j = 2, n do a, b = b, a + b end
            return b
        end
        offset = fib(char_index % 12) * 0.2
    elseif colour_prog_mode == "spiral" then
        local angle = (char_index - 1) * 0.8
        offset = angle + math.sin(angle * 0.3) * 2.0
    elseif colour_prog_mode == "rainbow" then
        offset = ((char_index - 1) / math.max(1, total_chars - 1)) * 20.0
    elseif colour_prog_mode == "heartbeat" then
        local beat_pos = (char_index - 1) % 8
        local heartbeat_pattern = {0, 3, 0.5, 0, 0, 2, 0.3, 0}
        offset = heartbeat_pattern[beat_pos + 1]
    elseif colour_prog_mode == "drift" then
        math.randomseed(text_seed + char_index)
        offset = math.random() * 0.8
    elseif colour_prog_mode == "scatter" then
        math.randomseed(text_seed + char_index)
        offset = math.random() * 2.5
    elseif colour_prog_mode == "chaos" then
        math.randomseed(text_seed + char_index)
        offset = math.random() * 10.0
    elseif colour_prog_mode == "random" then
        math.randomseed(text_seed + char_index)
        offset = math.random() * 15.0
    elseif colour_prog_mode == "ripple" then
        local center = (total_chars + 1) / 2
        local distance = math.abs(char_index - center)
        local ripple_freq = 0.8
        local decay = math.exp(-distance * 0.3)
        offset = math.sin(distance * ripple_freq) * 3.0 * decay
    elseif colour_prog_mode == "flow" then
        local flow_base = (char_index - 1) / total_chars * 4.0
        math.randomseed(text_seed + char_index)
        local turbulence = (math.random() - 0.5) * 0.6
        offset = flow_base + turbulence
    elseif colour_prog_mode == "breathing" then
        local breath_cycle = math.sin((char_index - 1) * 0.3) * 2.0
        offset = breath_cycle + math.sin((char_index - 1) * 0.1) * 0.5
    elseif colour_prog_mode == "cascade" then
        local cascade_delay = (char_index - 1) * 0.8
        offset = cascade_delay + math.sin(cascade_delay * 0.4) * 1.5
    elseif colour_prog_mode == "typewriter" then
        local reveal_pos = (char_index - 1) / math.max(1, total_chars - 1)
        offset = reveal_pos * 8.0 + math.sin(reveal_pos * 6.0) * 2.0
    elseif colour_prog_mode == "gradient_sweep" then
        local sweep_pos = (char_index - 1) / math.max(1, total_chars - 1)
        offset = sweep_pos * 12.0
    elseif colour_prog_mode == "mirror" then
        local center = (total_chars + 1) / 2
        local distance = math.abs(char_index - center)
        local mirror_phase = distance * 0.6
        offset = mirror_phase + math.sin(mirror_phase * 0.8) * 1.2
    elseif colour_prog_mode == "zigzag" then
        local zigzag_freq = 0.7
        local zigzag_amp = 3.0
        offset = math.sin((char_index - 1) * zigzag_freq) * zigzag_amp + (char_index - 1) * 0.2
    elseif colour_prog_mode == "strobe" then
        math.randomseed(text_seed + char_index)
        local strobe_state = math.random() > 0.5 and 8.0 or 0
        offset = strobe_state
    elseif colour_prog_mode == "spotlight" then
        local center = (total_chars + 1) / 2
        local distance = math.abs(char_index - center)
        local spotlight_intensity = math.exp(-distance * 0.4)
        offset = spotlight_intensity * 6.0
    elseif colour_prog_mode == "flicker" then
        math.randomseed(text_seed + char_index * 3)
        local base_flicker = math.sin((char_index - 1) * 0.5) * 2.0
        local random_flicker = (math.random() - 0.5) * 1.5
        offset = base_flicker + random_flicker
    end
    
    return offset
end


-- // MARK: SHINE PROG

-- calculate shine progression modifier for a character
local function get_shine_progression_modifier(char_index, total_chars, shine_prog_mode, text_seed)
    if shine_prog_mode == "shine_prog_off" then
        return 1.0 -- no modification
    end
    
    local modifier = 1.0
    
    if shine_prog_mode == "uniform" then
        modifier = 1.0 -- uniform shine
    elseif shine_prog_mode == "wave" then
        modifier = 0.7 + 0.3 * math.sin((char_index - 1) / total_chars * 2 * math.pi)
    elseif shine_prog_mode == "reverse_wave" then
        modifier = 0.7 + 0.3 * math.sin(((total_chars - char_index + 1) - 1) / total_chars * 2 * math.pi)
    elseif shine_prog_mode == "sine_wave" then
        modifier = 0.7 + 0.3 * math.sin((char_index - 1) * 0.6)
    elseif shine_prog_mode == "center_out" then
        local center = (total_chars + 1) / 2
        local distance = math.abs(char_index - center) / (total_chars / 2)
        modifier = 1.0 - (distance * 0.4) -- 0.6 to 1.0 range
    elseif shine_prog_mode == "edges_in" then
        local center = (total_chars + 1) / 2
        local distance = math.abs(char_index - center) / (total_chars / 2)
        modifier = 0.6 + (distance * 0.4) -- 0.6 to 1.0 range
    elseif shine_prog_mode == "pulse" then
        local pulse_freq = 0.5
        modifier = 0.6 + 0.4 * math.abs(math.sin((char_index - 1) * pulse_freq))
    elseif shine_prog_mode == "alternating" then
        modifier = (char_index % 2 == 0) and 1.0 or 0.7
    elseif shine_prog_mode == "fibonacci" then
        local function fib(n)
            if n <= 1 then return n end
            local a, b = 0, 1
            for j = 2, n do a, b = b, a + b end
            return b
        end
        local fib_val = fib(char_index % 12)
        modifier = 0.6 + (fib_val % 5) * 0.08 -- 0.6 to 0.92 range
    elseif shine_prog_mode == "spiral" then
        local angle = (char_index - 1) * 0.8
        modifier = 0.7 + 0.3 * math.abs(math.sin(angle * 0.3))
    elseif shine_prog_mode == "rainbow" then
        modifier = 0.7 + 0.3 * ((char_index - 1) / math.max(1, total_chars - 1))
    elseif shine_prog_mode == "heartbeat" then
        local beat_pos = (char_index - 1) % 8
        local heartbeat_pattern = {1.0, 0.9, 1.0, 0.7, 0.7, 0.8, 0.7, 0.7}
        modifier = heartbeat_pattern[beat_pos + 1]
    elseif shine_prog_mode == "drift" then
        local flow_shine = (char_index - 1) / math.max(1, total_chars - 1)
        math.randomseed(text_seed + char_index)
        local variation = (math.random() - 0.5) * 0.1
        modifier = 0.7 + 0.3 * flow_shine + variation
    elseif shine_prog_mode == "scatter" or shine_prog_mode == "chaos" or shine_prog_mode == "random" then
        math.randomseed(text_seed + char_index)
        modifier = 0.6 + (math.random() * 0.4) -- 0.6 to 1.0 range
    elseif shine_prog_mode == "ripple" then
        local center = (total_chars + 1) / 2
        local distance = math.abs(char_index - center)
        local decay = math.exp(-distance * 0.2)
        modifier = 0.6 + 0.4 * decay -- bright center, fade to edges
    elseif shine_prog_mode == "flow" then
        local flow_brightness = (char_index - 1) / math.max(1, total_chars - 1)
        math.randomseed(text_seed + char_index)
        local variation = (math.random() - 0.5) * 0.1
        modifier = 0.7 + 0.3 * flow_brightness + variation
    elseif shine_prog_mode == "breathing" then
        local breath_phase = math.sin((char_index - 1) * 0.3) * 0.2
        modifier = 0.8 + breath_phase -- gentle breathing brightness
    elseif shine_prog_mode == "cascade" then
        local cascade_pos = (char_index - 1) / math.max(1, total_chars - 1)
        local cascade_wave = math.sin(cascade_pos * 4.0) * 0.3
        modifier = 0.7 + cascade_wave
    elseif shine_prog_mode == "typewriter" then
        local reveal_pos = (char_index - 1) / math.max(1, total_chars - 1)
        modifier = 0.5 + 0.5 * reveal_pos -- progressive brightness reveal
    elseif shine_prog_mode == "gradient_sweep" then
        local sweep_pos = (char_index - 1) / math.max(1, total_chars - 1)
        modifier = 0.4 + 0.6 * sweep_pos -- smooth brightness gradient
    elseif shine_prog_mode == "mirror" then
        local center = (total_chars + 1) / 2
        local distance = math.abs(char_index - center)
        local mirror_brightness = 1.0 - (distance / (total_chars / 2)) * 0.4
        modifier = math.max(0.6, mirror_brightness)
    elseif shine_prog_mode == "zigzag" then
        local zigzag_brightness = math.sin((char_index - 1) * 0.7) * 0.2
        modifier = 0.8 + zigzag_brightness
    elseif shine_prog_mode == "strobe" then
        math.randomseed(text_seed + char_index)
        modifier = math.random() > 0.5 and 1.0 or 0.3 -- sharp on/off
    elseif shine_prog_mode == "spotlight" then
        local center = (total_chars + 1) / 2
        local distance = math.abs(char_index - center)
        local spotlight_brightness = math.exp(-distance * 0.4)
        modifier = 0.3 + 0.7 * spotlight_brightness -- bright center spotlight
    elseif shine_prog_mode == "flicker" then
        math.randomseed(text_seed + char_index * 3)
        local base_brightness = 0.8
        local flicker_amount = (math.random() - 0.5) * 0.4
        modifier = base_brightness + flicker_amount
    end
    
    return math.max(0.3, math.min(1.0, modifier)) -- clamp to reasonable range
end


-- per-letter shimmer function - applies different colors to each character
function M.get_letter_shimmer_markup(text, base_phase_offset, options)
    if not text or text == "" then return "" end
    
    options = options or {}
    local colour_prog_mode = options.colour_prog_mode or current_colour_prog_mode
    local shine_prog_mode = options.shine_prog_mode or current_shine_prog_mode
    
    -- validate UTF-8 and escape XML before processing
    local escaped_text = gears.string.xml_escape(text)
    
    -- check for invalid UTF-8 sequences and replace with safe fallback
    local safe_text = escaped_text:gsub("[\128-\255]+", function(match)
        -- replace problematic UTF-8 sequences with safe ASCII
        return "*"
    end)
    
    local chars = {}
    
    -- split into individual characters (handle utf-8 safely)
    for i = 1, safe_text:len() do
        local char = safe_text:sub(i, i)
        if char ~= "" then
            table.insert(chars, char)
        end
    end
    
    -- generate random seed based on text for consistent random phases
    local text_seed = 0
    for i = 1, #text do
        text_seed = text_seed + string.byte(text, i)
    end
    
    local colored_chars = {}
    for i, char in ipairs(chars) do
        if char:match("%s") then
            -- preserve whitespace
            table.insert(colored_chars, char)
        else
            local letter_phase = base_phase_offset or 0
            
            -- calculate color progression phase offset using new function
            local color_phase_offset = get_color_progression_offset(i, #chars, colour_prog_mode, text_seed)
            letter_phase = letter_phase + color_phase_offset
            
            -- get base color from palette
            local color = M.get_color(nil, 1, letter_phase)
            
            -- apply progression-based shine modification for HSV presets
            local config = shimmer_config[shimmer_mode]
            if config and config.use_gold_shine then
                -- parse the hex color to HSV, modify shine, convert back
                local function hex_to_hsv(hex)
                    hex = hex:gsub("#", "")
                    local r, g, b = tonumber(hex:sub(1,2), 16) / 255, tonumber(hex:sub(3,4), 16) / 255, tonumber(hex:sub(5,6), 16) / 255
                    local max = math.max(r, g, b)
                    local min = math.min(r, g, b)
                    local h, s, v = 0, 0, max
                    local d = max - min
                    s = max == 0 and 0 or d / max
                    if max ~= min then
                        if max == r then h = (g - b) / d + (g < b and 6 or 0)
                        elseif max == g then h = (b - r) / d + 2
                        elseif max == b then h = (r - g) / d + 4 end
                        h = h / 6
                    end
                    return h * 360, s, v
                end
                
                local shine_mod = get_shine_progression_modifier(i, #chars, shine_prog_mode, text_seed)
                local h, s, v = hex_to_hsv(color)
                v = v * shine_mod -- modify shine
                color = hsv_to_rgb(h, s, v)
            end
            
            table.insert(colored_chars, '<span foreground="' .. color .. '">' .. char .. '</span>')
        end
    end
    
    local result = table.concat(colored_chars)
    return result
end

